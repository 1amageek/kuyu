{
  "schemaVersion": "kuyu.embodiment.v1",
  "contractID": "roarm-m1-embodiment-v0",
  "bodyID": "roarm-m1-body-v0",
  "signals": {
    "sensor": [
      { "id": "joint_angle_1", "index": 0, "name": "base_to_L1 angle", "units": "rad", "rateHz": 50, "range": [-3.14, 3.14], "group": "proprioception" },
      { "id": "joint_angle_2", "index": 1, "name": "L1_to_L2 angle", "units": "rad", "rateHz": 50, "range": [-1.0467, 1.0467], "group": "proprioception" },
      { "id": "joint_angle_3", "index": 2, "name": "L2_to_L3 angle", "units": "rad", "rateHz": 50, "range": [-2.7, 2.7], "group": "proprioception" },
      { "id": "joint_angle_4", "index": 3, "name": "L3_to_L4 angle", "units": "rad", "rateHz": 50, "range": [-2.1, 2.1], "group": "proprioception" },
      { "id": "joint_angle_5", "index": 4, "name": "Gripper clamp angle", "units": "rad", "rateHz": 50, "range": [-1.57, 0], "group": "gripper-proprioception" }
    ],
    "actuator": [
      { "id": "joint_1", "index": 0, "name": "base_to_L1 target", "units": "rad", "rateHz": 50, "range": [-3.14, 3.14], "group": "joint" },
      { "id": "joint_2", "index": 1, "name": "L1_to_L2 target", "units": "rad", "rateHz": 50, "range": [-1.0467, 1.0467], "group": "joint" },
      { "id": "joint_3", "index": 2, "name": "L2_to_L3 target", "units": "rad", "rateHz": 50, "range": [-2.7, 2.7], "group": "joint" },
      { "id": "joint_4", "index": 3, "name": "L3_to_L4 target", "units": "rad", "rateHz": 50, "range": [-2.1, 2.1], "group": "joint" },
      { "id": "joint_5", "index": 4, "name": "Gripper clamp target", "units": "rad", "rateHz": 50, "range": [-1.57, 0], "group": "gripper" }
    ],
    "drive": [
      { "id": "drive_joint_1", "index": 0, "name": "Drive base_to_L1", "units": "rad", "rateHz": 50, "range": [-3.14, 3.14], "group": "joint-target" },
      { "id": "drive_joint_2", "index": 1, "name": "Drive L1_to_L2", "units": "rad", "rateHz": 50, "range": [-1.0467, 1.0467], "group": "joint-target" },
      { "id": "drive_joint_3", "index": 2, "name": "Drive L2_to_L3", "units": "rad", "rateHz": 50, "range": [-2.7, 2.7], "group": "joint-target" },
      { "id": "drive_joint_4", "index": 3, "name": "Drive L3_to_L4", "units": "rad", "rateHz": 50, "range": [-2.1, 2.1], "group": "joint-target" },
      { "id": "drive_joint_5", "index": 4, "name": "Drive gripper clamp", "units": "rad", "rateHz": 50, "range": [-1.57, 0], "group": "gripper-target" }
    ],
    "reflex": [
      { "id": "reflex_joint_1", "index": 0, "name": "base_to_L1 reflex correction", "units": "rad", "rateHz": 200, "range": [-0.034907, 0.034907], "group": "joint-reflex" },
      { "id": "reflex_joint_2", "index": 1, "name": "L1_to_L2 reflex correction", "units": "rad", "rateHz": 200, "range": [-0.034907, 0.034907], "group": "joint-reflex" },
      { "id": "reflex_joint_3", "index": 2, "name": "L2_to_L3 reflex correction", "units": "rad", "rateHz": 200, "range": [-0.034907, 0.034907], "group": "joint-reflex" },
      { "id": "reflex_joint_4", "index": 3, "name": "L3_to_L4 reflex correction", "units": "rad", "rateHz": 200, "range": [-0.034907, 0.034907], "group": "joint-reflex" },
      { "id": "reflex_joint_5", "index": 4, "name": "Gripper clamp reflex correction", "units": "rad", "rateHz": 200, "range": [-0.034907, 0.034907], "group": "gripper-reflex" }
    ],
    "descending": [
      { "id": "intent.end_effector.x", "index": 0, "name": "End effector x bias", "units": "m", "rateHz": 5, "range": [-0.1, 0.1], "group": "task-bias" },
      { "id": "intent.end_effector.y", "index": 1, "name": "End effector y bias", "units": "m", "rateHz": 5, "range": [-0.1, 0.1], "group": "task-bias" },
      { "id": "intent.end_effector.z", "index": 2, "name": "End effector z bias", "units": "m", "rateHz": 5, "range": [-0.1, 0.1], "group": "task-bias" },
      { "id": "intent.gripper", "index": 3, "name": "Gripper bias", "units": "norm", "rateHz": 5, "range": [0, 1], "group": "task-bias" },
      { "id": "intent.inhibition", "index": 4, "name": "Inhibition bias", "units": "norm", "rateHz": 5, "range": [0, 1], "group": "task-bias" }
    ],
    "summary": [
      { "id": "summary.salience", "index": 0, "name": "Salience", "units": "norm", "rateHz": 10, "range": [0, 1], "group": "upward-summary" },
      { "id": "summary.risk", "index": 1, "name": "Risk", "units": "norm", "rateHz": 10, "range": [0, 1], "group": "upward-summary" },
      { "id": "summary.uncertainty", "index": 2, "name": "Uncertainty", "units": "norm", "rateHz": 10, "range": [0, 1], "group": "upward-summary" },
      { "id": "summary.constraint_pressure", "index": 3, "name": "Constraint pressure", "units": "norm", "rateHz": 10, "range": [0, 1], "group": "upward-summary" },
      { "id": "summary.recovery_state", "index": 4, "name": "Recovery state", "units": "norm", "rateHz": 10, "range": [0, 1], "group": "upward-summary" }
    ],
    "motorNerve": []
  },
  "sensors": [
    {
      "id": "joint_encoder_bus",
      "type": "st3215-position-feedback",
      "frameID": "base",
      "channels": ["joint_angle_1", "joint_angle_2", "joint_angle_3", "joint_angle_4", "joint_angle_5"],
      "rateHz": 50,
      "latencySeconds": 0.02,
      "noise": {
        "bias": 0,
        "standardDeviation": 0.002,
        "randomWalkStandardDeviation": 0.0002
      }
    }
  ],
  "actuators": [
    { "id": "servo_1", "type": "ST3215 serial-bus-servo", "frameID": "servo_1_output", "channels": ["joint_1"], "limits": { "min": -3.14, "max": 3.14, "rateLimitPerSecond": 0.5 }, "dynamics": { "timeConstantSeconds": 0.08, "deadzone": 0.002, "torqueLimit": 2.941995, "damping": 0.025, "coulombFriction": 0.018 } },
    { "id": "servo_2", "type": "ST3215 serial-bus-servo with 1:3 joint reduction", "frameID": "servo_2_output", "channels": ["joint_2"], "limits": { "min": -1.0467, "max": 1.0467, "rateLimitPerSecond": 0.5 }, "dynamics": { "timeConstantSeconds": 0.09, "deadzone": 0.002, "torqueLimit": 2.941995, "damping": 0.025, "coulombFriction": 0.018 } },
    { "id": "servo_3", "type": "ST3215 serial-bus-servo", "frameID": "servo_3_output", "channels": ["joint_3"], "limits": { "min": -2.7, "max": 2.7, "rateLimitPerSecond": 0.5 }, "dynamics": { "timeConstantSeconds": 0.08, "deadzone": 0.002, "torqueLimit": 2.941995, "damping": 0.022, "coulombFriction": 0.016 } },
    { "id": "servo_4", "type": "ST3215 serial-bus-servo", "frameID": "servo_4_output", "channels": ["joint_4"], "limits": { "min": -2.1, "max": 2.1, "rateLimitPerSecond": 0.5 }, "dynamics": { "timeConstantSeconds": 0.07, "deadzone": 0.002, "torqueLimit": 2.941995, "damping": 0.018, "coulombFriction": 0.012 } },
    { "id": "servo_5", "type": "ST3215 serial-bus-servo gripper drive", "frameID": "servo_5_output", "channels": ["joint_5"], "limits": { "min": -1.57, "max": 0, "rateLimitPerSecond": 0.5 }, "dynamics": { "timeConstantSeconds": 0.06, "deadzone": 0.002, "torqueLimit": 2.941995, "damping": 0.015, "coulombFriction": 0.01 } }
  ],
  "control": {
    "driveChannels": ["drive_joint_1", "drive_joint_2", "drive_joint_3", "drive_joint_4", "drive_joint_5"],
    "reflexChannels": ["reflex_joint_1", "reflex_joint_2", "reflex_joint_3", "reflex_joint_4", "reflex_joint_5"],
    "descendingChannels": ["intent.end_effector.x", "intent.end_effector.y", "intent.end_effector.z", "intent.gripper", "intent.inhibition"],
    "summaryChannels": ["summary.salience", "summary.risk", "summary.uncertainty", "summary.constraint_pressure", "summary.recovery_state"],
    "constraints": {
      "driveClamp": [-3.14, 3.14],
      "reflexClamp": [-0.034907, 0.034907]
    },
    "latencyBudgets": {
      "reflexPathSeconds": 0.005,
      "corePathSeconds": 0.02,
      "descendingApplySeconds": 0.1,
      "summaryExportSeconds": 0.1
    }
  },
  "observation": {
    "clock": {
      "timebase": "simulation",
      "maxSkewSeconds": 0.002,
      "syncPolicy": "hard"
    },
    "modalities": [
      {
        "id": "joint-state",
        "type": "state",
        "channels": ["joint_angle_1", "joint_angle_2", "joint_angle_3", "joint_angle_4", "joint_angle_5"],
        "timestampSource": "simulation"
      }
    ]
  },
  "motorNerve": {
    "stages": [
      {
        "id": "joint-direct",
        "type": "direct",
        "inputs": ["drive_joint_1", "drive_joint_2", "drive_joint_3", "drive_joint_4", "drive_joint_5"],
        "outputs": ["joint_1", "joint_2", "joint_3", "joint_4", "joint_5"]
      }
    ]
  }
}
